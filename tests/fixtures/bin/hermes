#!/usr/bin/env bash
# Stub `hermes` CLI for offline tests. Records exact argv (one JSON array
# per line) to $DECK_ACT_RECORD when set, then answers only the
# subcommands the collector and deck-act tests may invoke.
set -euo pipefail
if [[ -n ${DECK_ACT_RECORD:-} ]]; then
  python3 -c 'import json,sys; print(json.dumps(["hermes"] + sys.argv[1:]))' "$@" >>"$DECK_ACT_RECORD"
fi
case "${1:-}" in
  --version) echo "stub 1.2.3" ;;
  pause) exit 0 ;;
  resume) exit 0 ;;
  gateway) [[ ${2:-} == restart ]] && exit 0; exit 64 ;;
  config)
    case "${2:-} ${3:-}" in
      "get model.default") echo "cli-resolved-model"; exit 0 ;;
      "set model.default") exit 0 ;;
      *) exit 64 ;;
    esac
    ;;
  auth)
    [[ ${2:-} == list ]] || exit 64
    cat <<'EOF'
openai-codex (1 credentials):
  #1  example-codex-oauth-1    oauth   device_code ←

xai-oauth (1 credentials):
  #1  example-xai-oauth-1    oauth   device_code ←
EOF
    ;;
  kanban)
    [[ ${2:-} == boards && ${3:-} == list ]] || exit 64
    cat <<'EOF'
[
  {"slug": "default", "name": "Default", "total": 3, "counts": {"running": 1, "review": 2}, "is_current": true}
]
EOF
    ;;
  sessions)
    # pin/unpin/rename take a session id (and a title) and mutate the store.
    # The real CLI accepts id prefixes, so the stub accepts any argv shape.
    case "${2:-}" in
      pin | unpin) exit 0 ;;
      rename) [[ -n ${3:-} && -n ${4:-} ]] && exit 0; exit 64 ;;
      # `archive` is bulk-only: the real CLI takes NO positional session id and
      # rejects one outright ("unrecognized arguments", exit 2). It also refuses
      # to run without at least one FILTER, and only --yes/--dry-run are value-less
      # flags — every other flag consumes the next token. Modelled on the real
      # argparse definition in hermes_cli/subcommands/sessions.py; an earlier stub
      # assumed every --flag takes a value, which certified argv shapes the real
      # CLI rejects and rejected one it accepts.
      archive)
        VALUE_FLAGS=' --older-than --newer-than --before --after --source --title
          --end-reason --cwd --min-messages --max-messages --model --provider
          --user --chat-id --chat-type --branch --min-tokens --max-tokens
          --min-cost --max-cost --min-tool-calls --max-tool-calls '
        args=("${@:3}")
        i=0; filters=0
        while (( i < ${#args[@]} )); do
          a=${args[i]}
          case $a in
            --yes|--dry-run) i=$((i + 1)) ;;            # value-less
            *=*) filters=$((filters + 1)); i=$((i + 1)) ;;   # --flag=value
            *)
              if [[ $VALUE_FLAGS == *" $a "* ]]; then
                (( i + 1 < ${#args[@]} )) || exit 2       # flag needs a value
                filters=$((filters + 1)); i=$((i + 2))
              else
                exit 2                                   # positional or unknown flag
              fi
              ;;
          esac
        done
        # Measured: the real CLI prints the refusal to STDOUT and still exits 0.
        # Only a malformed argv (unknown flag, positional, or a flag with no
        # value) exits 2 from argparse.
        (( filters > 0 )) || echo "Refusing to archive every ended session: pass at least one filter"
        exit 0 ;;
      delete) [[ -n ${3:-} ]] && exit 0; exit 64 ;;
      *) exit 64 ;;
    esac
    ;;
  cron)
    # `hermes cron list` has no --json. The stub emits the REAL format, kept in
    # tests/fixtures/hermes-cron-list.txt — which is not hand-written but
    # rendered by the CLI's own cron_list/_job_rows/_print_banner functions.
    # An earlier stub invented a table, which made a broken parser look correct.
    case "${2:-}" in
      list)
        cat <<'HERMES_CRON_EOF'

┌─────────────────────────────────────────────────────────────────────────┐
│                         Scheduled Jobs                                  │
└─────────────────────────────────────────────────────────────────────────┘

  182cc80c63f6 [active]
    Name:      nightly-backup
    Schedule:  0 3 * * *
    Repeat:    ∞
    Next run:  2026-09-23T03:00:00
    Deliver:   local
    Last run:  2026-09-22T03:00:00  ok

  aabbccddeeff [paused]
    Name:      weekly-digest
    Schedule:  0 9 * * 1
    Repeat:    ∞
    Next run:  -
    Deliver:   local

HERMES_CRON_EOF
        ;;
      pause | resume | run) exit 0 ;;
      *) exit 64 ;;
    esac
    ;;
  *) echo "stub hermes: unsupported call: $*" >&2; exit 64 ;;
esac
