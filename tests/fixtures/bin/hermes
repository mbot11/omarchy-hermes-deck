#!/usr/bin/env bash
# Stub `hermes` CLI for offline tests. Records exact argv (one JSON array
# per line) to $DECK_ACT_RECORD when set, then answers only the
# subcommands the collector and deck-act tests may invoke.
set -euo pipefail
if [[ -n ${DECK_ACT_RECORD:-} ]]; then
  python3 -c 'import json,sys; print(json.dumps(["hermes"] + sys.argv[1:]))' "$@" >>"$DECK_ACT_RECORD"
fi
case "${1:-}" in
  --version) echo "stub 1.2.3" ;;
  pause) exit 0 ;;
  resume) exit 0 ;;
  gateway) [[ ${2:-} == restart ]] && exit 0; exit 64 ;;
  config)
    case "${2:-} ${3:-}" in
      "get model.default") echo "cli-resolved-model"; exit 0 ;;
      "set model.default") exit 0 ;;
      *) exit 64 ;;
    esac
    ;;
  auth)
    [[ ${2:-} == list ]] || exit 64
    cat <<'EOF'
openai-codex (1 credentials):
  #1  example-codex-oauth-1    oauth   device_code ←

xai-oauth (1 credentials):
  #1  example-xai-oauth-1    oauth   device_code ←
EOF
    ;;
  kanban)
    [[ ${2:-} == boards && ${3:-} == list ]] || exit 64
    cat <<'EOF'
[
  {"slug": "default", "name": "Default", "total": 3, "counts": {"running": 1, "review": 2}, "is_current": true}
]
EOF
    ;;
  sessions)
    # pin/unpin/rename take a session id (and a title) and mutate the store.
    # The real CLI accepts id prefixes, so the stub accepts any argv shape.
    case "${2:-}" in
      pin | unpin) exit 0 ;;
      rename) [[ -n ${3:-} && -n ${4:-} ]] && exit 0; exit 64 ;;
      # `archive` is bulk-only: the real CLI takes NO positional session id and
      # rejects one outright (exit 2, "unrecognized arguments"). The stub mirrors
      # that, so a future caller that passes an id is caught here rather than in
      # production. `delete` is the subcommand that does take a positional id.
      archive)
        # Walk the args, skipping the value of each --flag. A bare token that is
        # not consumed as a flag value is a positional id, which must fail.
        args=("${@:3}")
        i=0
        while (( i < ${#args[@]} )); do
          if [[ ${args[i]} == --* ]]; then
            if [[ ${args[i]} == *=* ]]; then
              i=$((i + 1))          # --flag=value carries its own value
            else
              i=$((i + 2))          # --flag value
            fi
          else
            exit 2                  # bare positional id -> unrecognized
          fi
        done
        exit 0 ;;
      delete) [[ -n ${3:-} ]] && exit 0; exit 64 ;;
      *) exit 64 ;;
    esac
    ;;
  cron)
    # `hermes cron list` has no --json. The stub reproduces the REAL format,
    # copied from the installed CLI's own formatter (hermes_cli/cli_commands_mixin,
    # `_cron_list`): a label block per job, NOT a column-aligned table. The first
    # version of this stub invented a table, which made a broken parser look
    # correct.
    case "${2:-}" in
      list)
        cat <<'EOF'
Scheduled Jobs:  --------------------------------------------------------------------------------
  ID: a1b2c3d4        Name: nightly-backup
  State: active
  Schedule: 0 3 * * * (daily)
  Next run: 2026-09-23T03:00:00
  Prompt: back up the vault

  ID: e5f6a7b8        Name: weekly-digest
  State: paused
  Schedule: 0 9 * * 1 (weekly)
  Next run: 2026-09-28T09:00:00
  Prompt: summarize the week

EOF
        ;;
      pause | resume | run) exit 0 ;;
      *) exit 64 ;;
    esac
    ;;
  *) echo "stub hermes: unsupported call: $*" >&2; exit 64 ;;
esac
