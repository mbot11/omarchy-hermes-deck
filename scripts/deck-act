#!/usr/bin/env bash
# Hermes Deck action dispatcher.
#
# The only component allowed to *change* Hermes state from the plugin. Every
# action is a fixed-argument exec of a documented Hermes/Omarchy command; the
# caller passes an action name, never a command string. Dynamic values (a
# session id, a model id, a chat prompt) are validated here before use.
#
# Usage: deck-act <action> [arg]
#   pause                        hermes pause
#   resume                       hermes resume
#   gateway-restart              hermes gateway restart
#   new-session [prompt]         launch Hermes TUI, optionally seeded with -z
#   resume-session <session-id>  resume a session in the Hermes TUI
#   set-model <model-id>         hermes config set model.default <model-id>
#
# Prints "ok" on success; errors go to stderr with a nonzero exit.

set -euo pipefail

usage() {
  echo "usage: deck-act pause|resume|gateway-restart|launch-desktop|set-default-agent|new-session [prompt]|resume-session <id>|set-model <model>|pin-session <id>|unpin-session <id>|rename-session <id> <title>" >&2
  exit 64
}

OMARCHY_BIN="${OMARCHY_BIN:-/usr/bin/omarchy}"
UWSM_APP="${UWSM_APP:-/usr/bin/uwsm-app}"
HERMES_DESKTOP="${HERMES_DESKTOP:-/usr/bin/hermes-desktop}"

# PATH first, then the standard user/system locations: the Omarchy shell's
# PATH can omit ~/.local/bin, where Hermes self-installs.
hermes_bin() {
  if command -v hermes >/dev/null 2>&1; then
    command -v hermes
    return
  fi
  local candidate
  for candidate in "$HOME/.local/bin/hermes" /usr/local/bin/hermes /usr/bin/hermes; do
    [[ -x $candidate ]] && { printf '%s' "$candidate"; return; }
  done
  echo "deck-act: hermes not found on PATH or standard locations" >&2
  exit 69
}

launch_tui() {
  local app_id=org.omarchy.agent
  # Pinned to the packaged launcher; the env override exists so tests can
  # stub it. Same-user trust boundary either way.
  exec "${OMARCHY_LAUNCH_TUI:-/usr/bin/omarchy-launch-tui}" --app-id="$app_id" "$@"
}

# One gate for every session id the plugin accepts. Hermes ids look like
# 20260904_204532_c3ca2e and uuid-shaped ids also occur; the leading
# character may not be a dash or the value could parse as a CLI option.
# Defined once so a new session action cannot ship with a weaker check.
require_session_id() {
  [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$ ]] || {
    echo "deck-act: invalid session id" >&2
    exit 65
  }
}

(( $# >= 1 )) || usage
action=$1
shift
case "$action" in
  pause)
    exec "$(hermes_bin)" pause
    ;;
  resume)
    exec "$(hermes_bin)" resume
    ;;
  gateway-restart)
    exec "$(hermes_bin)" gateway restart
    ;;
  launch-desktop)
    exec /usr/bin/setsid "$UWSM_APP" -- "$HERMES_DESKTOP"
    ;;
  set-default-agent)
    exec "$OMARCHY_BIN" default agent hermes
    ;;
  new-session)
    prompt=${1:-}
    if [[ -z $prompt ]]; then
      launch_tui env -u HERMES_SESSION_SOURCE hermes --yolo
    else
      # -z seeds the interactive TUI with a prompt; passed as one argv entry.
      launch_tui env -u HERMES_SESSION_SOURCE hermes --yolo -z "$prompt"
    fi
    ;;
  resume-session)
    (( $# == 1 )) || usage
    session_id=$1
    require_session_id "$session_id"
    launch_tui hermes --tui --resume "$session_id"
    ;;
  set-model)
    (( $# == 1 )) || usage
    model_id=$1
    # Model ids: alphanumerics plus . _ : / - (e.g. gpt-oss:120b, glm-5.3-flash).
    # The first character may not be a dash, or the value could parse as a
    # CLI option instead of a value.
    # No dot-dot segment: the value is passed as one argv entry and never opened
    # as a path, so this is not a security boundary — but `../../etc/passwd` as a
    # model id is a confusing state to leave in the config.
    [[ $model_id != *..* ]] || {
      echo "deck-act: invalid model id" >&2
      exit 65
    }
    [[ $model_id =~ ^[A-Za-z0-9._:/][A-Za-z0-9._:/-]{0,127}$ ]] || {
      echo "deck-act: invalid model id" >&2
      exit 65
    }
    exec "$(hermes_bin)" config set model.default "$model_id"
    ;;
  pin-session | unpin-session)
    (( $# == 1 )) || usage
    session_id=$1
    require_session_id "$session_id"
    # The same flag the Desktop sidebar's Pinned section reads, so a pin set
    # from the bar is visible in Hermes Desktop without a second source.
    verb=${action%-session}
    exec "$(hermes_bin)" sessions "$verb" "$session_id"
    ;;
  rename-session)
    (( $# == 2 )) || usage
    session_id=$1
    new_title=$2
    require_session_id "$session_id"
    # A title is free text the user typed. It travels as one argv entry, so
    # only its length and emptiness need a gate; shell metacharacters in it
    # are data, not syntax.
    (( ${#new_title} > 0 )) || {
      echo "deck-act: title must not be empty" >&2
      exit 65
    }
    (( ${#new_title} <= 200 )) || {
      echo "deck-act: title must be 200 characters or fewer" >&2
      exit 65
    }
    [[ $new_title != *$'\n'* ]] || {
      echo "deck-act: title must be one line" >&2
      exit 65
    }
    exec "$(hermes_bin)" sessions rename "$session_id" "$new_title"
    ;;
  *)
    usage
    ;;
esac
